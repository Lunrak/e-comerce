{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "src/types/**/*.ts",
    "src/features/auth/**/*.ts",
    "src/features/data/**/*.ts",
    "src/lib/**/*.ts",
    "src/env.d.ts"
  ]
}
